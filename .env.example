# Copy this file to .env and fill the blank values before local use.
# The real .env is ignored by Git and Docker build context. Never commit secrets.

# Application identity
APP_NAME=Enterprise RAG Knowledge Base
APP_VERSION=0.1.0

# Host-run database configuration
# Example shape only: postgresql+psycopg://USER:PERCENT_ENCODED_PASSWORD@localhost:5432/DB_NAME
# TEST_DATABASE_URL is mandatory for database tests, must differ from DATABASE_URL,
# and its database name must end with _test.
DATABASE_URL=
TEST_DATABASE_URL=

# Authentication
# Generate a private high-entropy value with at least 32 UTF-8 bytes.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Generation LLM (development profile: local Ollama)
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma3:4b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
# LLM_SEED=42
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5
# Formal generation evaluation uses LLM_MODEL=qwen3:8b with the same RAG pipeline.
# Keep one fixed model throughout a formal benchmark; do not mix model results.

# Embeddings
EMBEDDING_PROVIDER=local_model
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_TO_LOCAL=true

# Vector storage
VECTOR_STORE_BACKEND=faiss
VECTOR_STORE_EXTERNAL_PROVIDER=
VECTOR_STORE_URL=
VECTOR_STORE_COLLECTION=enterprise_rag_chunks
VECTOR_STORE_API_KEY=
VECTOR_STORE_TIMEOUT_SECONDS=10

# Retrieval, reranking, and context construction
KEYWORD_MIN_SCORE=0.2
VECTOR_MIN_SCORE=0.2
HYBRID_MIN_SCORE=0.2
HYBRID_KEYWORD_WEIGHT=0.8
HYBRID_VECTOR_WEIGHT=0.2
RERANK_MIN_SCORE=0.2
RERANK_CANDIDATE_MULTIPLIER=6
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_LOCAL_FILES_ONLY=true
CONTEXT_WINDOW_CHUNKS=1
MAX_EXPANDED_CONTEXTS=8

# Runtime logging and RAG security mode
RAG_STRUCTURED_LOGGING_ENABLED=true
RAG_STRUCTURED_LOG_PATH=logs/rag.jsonl
RAG_SECURITY_MODE=layered

# Docker Compose inputs
# Compose maps these COMPOSE_* inputs to the canonical application settings above.
# COMPOSE_POSTGRES_PASSWORD and the percent-encoded password inside
# COMPOSE_DATABASE_URL must represent the same password.
# Example URL shape: postgresql+psycopg://enterprise_rag:PERCENT_ENCODED_PASSWORD@postgres:5432/enterprise_rag
COMPOSE_POSTGRES_DB=enterprise_rag
COMPOSE_POSTGRES_USER=enterprise_rag
COMPOSE_POSTGRES_PASSWORD=
COMPOSE_DATABASE_URL=
COMPOSE_JWT_SECRET_KEY=
COMPOSE_LLM_PROVIDER=ollama
COMPOSE_LLM_API_KEY=ollama
COMPOSE_LLM_BASE_URL=http://host.docker.internal:11434/v1
COMPOSE_LLM_MODEL=gemma3:4b
COMPOSE_BACKEND_PORT=8000
